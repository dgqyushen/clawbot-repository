# Zotero Crawler Environment Variables
# Copy this file to .env and fill in your actual keys
# NEVER commit .env to version control!

# Semantic Scholar API Key
# Get from: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Zotero API Credentials
# Get from: https://www.zotero.org/settings/keys
ZOTERO_LIBRARY_ID=14021209
ZOTERO_API_KEY=
ZOTERO_LIBRARY_TYPE=user

# Bark Notification
# Device key from Bark app
BARK_KEY=
BARK_URL=https://bark.deepthinks.org
